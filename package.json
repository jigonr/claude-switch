{
  "name": "@jigonr/claude-switch",
  "version": "0.1.6",
  "description": "Simple API provider switcher for Claude Code CLI",
  "type": "module",
  "license": "MIT",
  "author": "J.I. Gonzalez-Rojas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jigonr/claude-switch.git"
  },
  "bugs": {
    "url": "https://github.com/jigonr/claude-switch/issues"
  },
  "homepage": "https://github.com/jigonr/claude-switch#readme",
  "keywords": [
    "claude",
    "cli",
    "provider",
    "switch",
    "anthropic",
    "ai",
    "z.ai",
    "glm"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "claude-switch": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "bun check --no-script -p tsconfig.json && bun check --no-script tsup.config.ts vitest.config.ts && bun check --no-script --allowJs --checkJs tests/integration/cli.test.js",
    "format": "bun fmt --no-script src tests package.json tsconfig.json tsup.config.ts vitest.config.ts",
    "format:check": "bun run format --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prerelease": "bun run format:check && bun run typecheck && bun run build && bun run test",
    "release": "npm publish --access public"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "date-fns": "^4.1.0",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ora": "^8.1.1",
    "react": "^18.3.1",
    "tiny-invariant": "^1.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "execa": "^9.5.2",
    "ink-testing-library": "^4.0.0",
    "publint": "^0.2.11",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
